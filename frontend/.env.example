# Copia este archivo como .env (obligatorio: se empaqueta como asset).
# URL base de la API REST (incluye /api, sin barra final).
#   Emulador Android:     http://10.0.2.2:3000/api
#   Web / Windows / iOS:  http://localhost:3000/api
#   Dispositivo físico:   http://<IP_LAN_DEL_PC>:3000/api
API_BASE_URL=http://10.0.2.2:3000/api
# Tiempo máximo de espera de las peticiones (milisegundos)
API_TIMEOUT_MS=10000
